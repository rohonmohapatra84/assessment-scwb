"""Tests for CHG-001: optional link expiry (generated by test_generator for the brownfield change)."""
import os
import sqlite3
import tempfile
import unittest

from shortener.config import Config
from shortener.errors import BadRequest, LinkExpired
from shortener.models import Visitor
from shortener.service import ShortenerService
from shortener.storage import MIGRATIONS, Repository

from .helpers import FakeClock, make_app

VISITOR = Visitor(ip="203.0.113.5", user_agent="Mozilla/5.0 (X11; Linux)")


def create(client, **extra):
    return client.request("POST", "/api/v1/links", {"url": "https://example.com/e", **extra})


class ExpiryServiceTests(unittest.TestCase):
    def setUp(self):
        self.app, self.service, self.clock, self.client = make_app()

    def test_link_without_expiry_never_expires(self):
        code = self.service.create_link("https://example.com").code
        self.clock.advance(10 * 365 * 86400)
        self.assertEqual(self.service.resolve(code, VISITOR), "https://example.com")

    def test_resolve_before_and_after_expiry(self):
        code = self.service.create_link("https://example.com", expires_in_seconds=60).code
        self.clock.advance(59)
        self.assertEqual(self.service.resolve(code, VISITOR), "https://example.com")
        self.clock.advance(1)  # exactly at expiry: expired
        with self.assertRaises(LinkExpired):
            self.service.resolve(code, VISITOR)

    def test_cached_link_expires(self):
        code = self.service.create_link("https://example.com", expires_in_seconds=60).code
        self.service.resolve(code, VISITOR)  # populates the cache
        self.assertEqual(self.service.cache.stats()["size"], 1)
        self.clock.advance(61)
        with self.assertRaises(LinkExpired):  # expiry is checked on the cached object
            self.service.resolve(code, VISITOR)

    def test_expires_at_is_absolute_utc_iso(self):
        link = self.service.create_link("https://example.com", expires_in_seconds=3600)
        self.assertEqual(link.expires_at, "2026-01-01T13:00:00+00:00")

    def test_invalid_expiry_values_rejected(self):
        for bad in (59, 31536001, -5, 0, "60", 1.5, True):
            with self.subTest(value=bad):
                with self.assertRaises(BadRequest):
                    self.service.create_link("https://example.com", expires_in_seconds=bad)

    def test_boundary_values_accepted(self):
        for ok in (60, 31536000):
            self.assertIsNotNone(self.service.create_link("https://example.com", expires_in_seconds=ok).expires_at)


class ExpiryApiTests(unittest.TestCase):
    def setUp(self):
        self.app, self.service, self.clock, self.client = make_app()

    def test_create_with_expiry_returns_expires_at(self):
        r = create(self.client, expires_in_seconds=120)
        self.assertEqual(r.status, 201)
        self.assertEqual(r.json()["expires_at"], "2026-01-01T12:02:00+00:00")

    def test_create_without_expiry_has_null_expires_at(self):
        self.assertIsNone(create(self.client).json()["expires_at"])

    def test_redirect_ok_then_410_after_expiry(self):
        code = create(self.client, expires_in_seconds=60).json()["code"]
        self.assertEqual(self.client.request("GET", f"/{code}").status, 302)
        self.clock.advance(60)
        r = self.client.request("GET", f"/{code}")
        self.assertEqual(r.status, 410)
        self.assertEqual(r.json()["error"]["code"], "link_expired")

    def test_invalid_expiry_is_400(self):
        for bad in (10, "soon", 99999999999, 12.5):
            with self.subTest(value=bad):
                self.assertEqual(create(self.client, expires_in_seconds=bad).status, 400)

    def test_metadata_includes_expires_at(self):
        code = create(self.client, expires_in_seconds=300).json()["code"]
        self.assertEqual(self.client.request("GET", f"/api/v1/links/{code}").json()["expires_at"], "2026-01-01T12:05:00+00:00")

    def test_expired_hits_are_not_counted_but_stats_remain_available(self):
        code = create(self.client, expires_in_seconds=60).json()["code"]
        self.client.request("GET", f"/{code}")
        self.clock.advance(60)
        self.client.request("GET", f"/{code}")  # 410, must not be recorded as a click
        self.service.recorder.flush()
        r = self.client.request("GET", f"/api/v1/links/{code}/stats")
        self.assertEqual((r.status, r.json()["total_clicks"]), (200, 1))

    def test_delete_still_works_on_expired_link(self):
        code = create(self.client, expires_in_seconds=60).json()["code"]
        self.clock.advance(120)
        self.assertEqual(self.client.request("DELETE", f"/api/v1/links/{code}").status, 204)


class ExpiryMigrationTests(unittest.TestCase):
    def _make_v1_database(self, path):
        """Build a database exactly as the pre-change release left it (schema v1 + one legacy link)."""
        conn = sqlite3.connect(path)
        for stmt in (s.strip() for s in dict(MIGRATIONS)[1].split(";")):
            if stmt:
                conn.execute(stmt)
        conn.execute("CREATE TABLE schema_migrations (version INTEGER PRIMARY KEY, applied_at TEXT NOT NULL)")
        conn.execute("INSERT INTO schema_migrations VALUES (1, '2025-12-01T00:00:00+00:00')")
        conn.execute("INSERT INTO links (code, long_url, created_at) VALUES ('legacy1', 'https://legacy.example', '2025-12-01T00:00:00+00:00')")
        conn.commit()
        conn.close()

    def test_migration_from_v1(self):
        with tempfile.TemporaryDirectory() as d:
            path = os.path.join(d, "v1.db")
            self._make_v1_database(path)
            repo = Repository(path)
            self.assertEqual(repo.schema_version(), 2)
            link = repo.get_link("legacy1")
            self.assertEqual(link.long_url, "https://legacy.example")  # no data loss
            self.assertIsNone(link.expires_at)
            repo.close()

    def test_legacy_rows_never_expire(self):
        with tempfile.TemporaryDirectory() as d:
            path = os.path.join(d, "v1.db")
            self._make_v1_database(path)
            clock = FakeClock()
            repo = Repository(path)
            service = ShortenerService(repo, Config(db_path=path), now=clock)
            clock.advance(20 * 365 * 86400)
            self.assertEqual(service.resolve("legacy1", VISITOR), "https://legacy.example")
            repo.close()

    def test_migration_is_idempotent(self):
        with tempfile.TemporaryDirectory() as d:
            path = os.path.join(d, "v1.db")
            self._make_v1_database(path)
            Repository(path).close()
            again = Repository(path)
            self.assertEqual(again.schema_version(), 2)
            again.close()


if __name__ == "__main__":
    unittest.main()
