# Copy to .env and fill in ONE provider. The harness works with any model that can return JSON.
# Check your setup with:  python scripts/model_smoke.py
# Leave AGENTIC_PROVIDER unset to auto-detect from which settings exist (order: azure, command, openai, anthropic).

# AGENTIC_PROVIDER=azure          # azure | openai | anthropic | command
# AGENTIC_MODEL=                  # model id, or the Azure deployment name

# --- azure: Azure AI Foundry / Azure OpenAI ------------------------------------------------------------------------
# AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_AI_DEPLOYMENT=<deployment name>
# AZURE_AI_API_KEY=<key>          # omit to use Microsoft Entra ID (az login locally, managed identity in Azure)

# --- openai: any OpenAI-compatible chat-completions API ------------------------------------------------------------
# OpenAI, GitHub Models, OpenRouter, Ollama, vLLM, LM Studio ... (only the base URL and key differ)
# AGENTIC_BASE_URL=https://api.openai.com/v1
# AGENTIC_MODEL=<model id>
# AGENTIC_API_KEY=<key>           # or OPENAI_API_KEY; not needed for a local server

# --- anthropic: Claude ---------------------------------------------------------------------------------------------
# ANTHROPIC_API_KEY=<key>
# AGENTIC_MODEL=claude-sonnet-5-5 # optional

# --- command: any CLI that reads the prompt on stdin and prints a reply --------------------------------------------
# For tools that have a command line but no public model API. You supply the command exactly as you would type it.
# AGENTIC_LLM_COMMAND=<your tool's non-interactive command>
