// Agentic SDLC on Azure: Container Apps + ACR + Log Analytics, calling an EXISTING Azure AI Foundry model
// through the app's managed identity (no model key stored anywhere).
//
//   az deployment group create -g <rg> -f infra/main.bicep -p foundryResourceName=... foundryEndpoint=... apiToken=...
//   (infra/deploy.ps1 wraps this together with the image build)
targetScope = 'resourceGroup'

@description('Azure region for the new resources.')
param location string = resourceGroup().location

@description('Prefix for resource names (3-12 lowercase letters/digits).')
@minLength(3)
@maxLength(12)
param namePrefix string = 'agentic'

@description('Name of the EXISTING Foundry / Azure OpenAI (Azure AI Services) resource that hosts the model deployment.')
param foundryResourceName string

@description('Resource group of that Foundry resource (defaults to this resource group).')
param foundryResourceGroup string = resourceGroup().name

@description('Endpoint of the Foundry resource, e.g. https://myresource.openai.azure.com (or https://myresource.services.ai.azure.com).')
param foundryEndpoint string

@description('Name of the model DEPLOYMENT inside Foundry (not the model family), e.g. gpt-4.1.')
param foundryDeployment string

@description('Bearer token callers must present to the API. Generated by deploy.ps1; store it in a password manager.')
@secure()
param apiToken string

@description('Container image. The first deployment uses a public placeholder; deploy.ps1 then builds and swaps in the real image.')
param image string = 'mcr.microsoft.com/k8se/quickstart:latest'

@description('Port the container listens on. 80 for the placeholder image, 8080 for the real one.')
param targetPort int = 80

@description('Pull the image from the private ACR using the managed identity (false for the first, placeholder deployment).')
param pullFromAcr bool = false

@description('How long an unattended human gate waits before it is rejected (seconds).')
param gateTimeoutSeconds int = 3600

var suffix = uniqueString(resourceGroup().id)
var acrName = toLower('${namePrefix}${suffix}')
var appName = '${namePrefix}-api'

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: '${namePrefix}-logs-${suffix}'
  location: location
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource acr 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: acrName
  location: location
  sku: { name: 'Basic' }
  properties: {
    adminUserEnabled: false // pulls use the app's managed identity, not a shared admin password
  }
}

resource env 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: '${namePrefix}-env'
  location: location
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: {
        customerId: logs.properties.customerId
        sharedKey: logs.listKeys().primarySharedKey
      }
    }
  }
}

resource app 'Microsoft.App/containerApps@2024-03-01' = {
  name: appName
  location: location
  identity: { type: 'SystemAssigned' }
  properties: {
    managedEnvironmentId: env.id
    configuration: {
      ingress: {
        external: true
        targetPort: targetPort
        transport: 'auto'
        allowInsecure: false
      }
      // Only after the identity exists and holds AcrPull (second deployment); the first one uses a public image.
      registries: pullFromAcr ? [
        {
          server: acr.properties.loginServer
          identity: 'system'
        }
      ] : []
      secrets: [
        { name: 'api-token', value: apiToken }
      ]
    }
    template: {
      containers: [
        {
          name: 'api'
          image: image
          resources: { cpu: json('1.0'), memory: '2Gi' }
          env: [
            { name: 'AZURE_AI_ENDPOINT', value: foundryEndpoint }
            { name: 'AZURE_AI_DEPLOYMENT', value: foundryDeployment }
            { name: 'AGENTIC_API_TOKEN', secretRef: 'api-token' }
            { name: 'AGENTIC_DATA_DIR', value: '/data' }
            { name: 'AGENTIC_GATE_TIMEOUT', value: string(gateTimeoutSeconds) }
            { name: 'PORT', value: string(targetPort) }
          ]
          probes: [
            {
              type: 'Liveness'
              httpGet: { path: '/healthz', port: targetPort }
              periodSeconds: 20
            }
            {
              type: 'Readiness'
              httpGet: { path: '/healthz', port: targetPort }
              periodSeconds: 10
            }
          ]
        }
      ]
      // Exactly one replica: run state and pending approval gates live in process memory.
      scale: { minReplicas: 1, maxReplicas: 1 }
    }
  }
}

// The app's identity may pull its image from ACR ...
var acrPullRoleId = '7f951dda-4ed3-4680-a7ca-43fe172d538d'
resource acrPull 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(acr.id, app.id, acrPullRoleId)
  scope: acr
  properties: {
    principalId: app.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', acrPullRoleId)
  }
}

// ... and call the Foundry model (role is assigned on the Foundry resource, possibly in another resource group).
module foundryAccess 'rbac.bicep' = {
  name: 'foundry-rbac'
  scope: resourceGroup(foundryResourceGroup)
  params: {
    foundryResourceName: foundryResourceName
    principalId: app.identity.principalId
  }
}

output appName string = app.name
output appUrl string = 'https://${app.properties.configuration.ingress.fqdn}'
output acrName string = acr.name
output principalId string = app.identity.principalId
